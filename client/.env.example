# ---------- API location ----------
# LOCAL DEVELOPMENT: leave EMPTY. The browser then calls /api on its own host (e.g. brost.localhost:5173)
# and the Vite dev server forwards it to the API, keeping the Host header so the API knows the restaurant.
# Setting http://localhost:4000 here would make every restaurant subdomain a cross-site caller: the
# per-restaurant session cookie would no longer be sent and staff sign-in would not persist.
# PRODUCTION: also leave empty (the API is served from the same origin).
VITE_API_URL=

# Must match the server ROOT_DOMAIN (production value lives in client/.env.production).
VITE_ROOT_DOMAIN=localhost
# Must match the server TENANT_URL_MODE. "path" (default): restaurants at http://localhost:5173/r/<slug>.
# "subdomain": links point to <slug>.VITE_ROOT_DOMAIN. Pages opened on a subdomain keep working either way.
VITE_TENANT_URL_MODE=path

# ---------- Local dev server (optional; defaults shown) ----------
# Port of the Vite dev server. Restaurant links and QR codes use the port the browser is on.
# VITE_DEV_PORT=5173
# Where Vite forwards /api, /uploads and /socket.io.
# VITE_DEV_API_TARGET=http://localhost:4000
# Interface Vite listens on. Default "localhost" keeps the dev server private to this laptop.
# Set 0.0.0.0 (or run `npm run dev:lan`) only to reach it from other devices on your network.
# VITE_DEV_HOST=localhost
