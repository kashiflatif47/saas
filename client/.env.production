# Production build settings (compiled into the bundle at BUILD time; not secrets).
# Committed on purpose so the Hostinger build always gets them. A real environment variable with the same name
# set in the build environment still takes precedence over this file.
VITE_ROOT_DOMAIN=nftloyal.shop
# Restaurants live at https://nftloyal.shop/r/<slug> (must match the server TENANT_URL_MODE, default "path").
VITE_TENANT_URL_MODE=path
# Same-origin API (Express serves client/dist and /api from one Node.js app).
VITE_API_URL=
